{
  "name": "rocketseat-fastify",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx/esm --env-file=.env.local --watch src/server.ts",
    "env:setup": "cp .env.example .env.local",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "local:setup": "npm run env:setup && npm run infra:up",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx drizzle-kit migrate",
    "db:push": "npx drizzle-kit push",
    "types:check": "tsc --noEmit",
    "test": "NODE_ENV=test node --import tsx/esm --experimental-test-module-mocks --test",
    "test:unit": "NODE_ENV=test node --import tsx/esm --experimental-test-module-mocks --test 'src/modules/shared/utils/*.test.ts' 'src/modules/shared/auth/*.test.ts' 'src/modules/shared/config/*.test.ts' 'src/features/*/domain/**/*.test.ts' 'src/features/*/application/*.test.ts' 'src/features/*/infrastructure/ai/**/*.test.ts' 'src/features/*/interfaces/http/handlers/*.test.ts'",
    "test:integration": "NODE_ENV=test node --import tsx/esm --experimental-test-module-mocks --test 'src/features/*/__tests__/*.integration.test.ts'",
    "test:e2e": "NODE_ENV=test node --import tsx/esm --experimental-test-module-mocks --test 'src/features/*/__tests__/*.e2e.test.ts'",
    "test:coverage": "NODE_ENV=test node --import tsx/esm --experimental-test-module-mocks --experimental-test-coverage --test"
  },
  "dependencies": {
    "@fastify/type-provider-zod": "^1.0.0",
    "@mastra/core": "^1.54.0",
    "@scalar/fastify-api-reference": "^1.63.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.0.9",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^6.0.0",
    "pg": "^8.22.0",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nanoid": "^2.1.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
